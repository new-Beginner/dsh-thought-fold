{
  "name": "dsh-thought-fold",
  "version": "1.0.1",
  "description": "DeepSeek Harness 的 Codex 风格进度可视化与原生过程折叠增强插件（安全修复版）",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./web": "./src/web.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/new-Beginner/dsh-thought-fold.git"
  },
  "homepage": "https://github.com/new-Beginner/dsh-thought-fold#readme",
  "bugs": {
    "url": "https://github.com/new-Beginner/dsh-thought-fold/issues"
  },
  "author": "new-Beginner",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0",
    "@deepseek-ai/dsh-settings": ">=0.1.0",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test/run.js",
    "pack:plugin": "npm pack --cache ./.npm-cache && node -e \"require('node:fs').rmSync('.npm-cache', {recursive:true, force:true})\""
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "thought-fold",
    "thinking",
    "tool-calls",
    "codex",
    "folding",
    "hud"
  ]
}
